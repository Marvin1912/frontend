{
  "name": "frontend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:nice": "nice -n 15 ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "env:production": "node scripts/generate-env.js --build-time --node-version --angular-version --npm-version",
    "owasp": "owasp-dependency-check --project \"frontend\" --scan \"package-lock.json\" --out reports --format HTML"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.2",
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/material": "22.2.2",
    "@angular/material-date-fns-adapter": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/platform-browser-dynamic": "22.2.2",
    "@angular/router": "22.2.2",
    "bootstrap": "5.3.8",
    "chart.js": "4.5.1",
    "date-fns": "4.4.0",
    "ng2-charts": "11.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.2",
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@types/jasmine": "5.1.15",
    "@vitest/coverage-v8": "5.0.3",
    "baseline-browser-mapping": "2.11.21",
    "istanbul-lib-instrument": "6.0.3",
    "jasmine-core": "5.13.0",
    "jsdom": "30.1.2",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "owasp-dependency-check": "1.0.1",
    "sass": "1.104.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
